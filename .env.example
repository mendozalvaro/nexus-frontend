# Local development defaults to the remote DEV project.
# Copy this file to `.env.local` for day-to-day work.

# Supabase - dev
NUXT_PUBLIC_SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_DEV_ANON_KEY
NUXT_SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY
SUPABASE_PROJECT_ID=YOUR_DEV_PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DEV_DB_PASSWORD

# App
NUXT_PUBLIC_APP_BASE_URL=https://your-domain.example.com
NUXT_APP_NAME=NexusPOS
NUXT_APP_BASE_URL=/
NUXT_RECEIPT_VERIFICATION_SECRET=CHANGE_ME
NUXT_DEV_ADMIN_KEY=CHANGE_ME

# Keep local development in development mode.
NODE_ENV=development

# Production values belong in deploy secrets or a private `.env.production`.
# Do not point local day-to-day work at the production project.
